# All keys are SERVER-SIDE ONLY. Nothing here is ever exposed to the browser.

# Agent dashboard login (set a strong value in production)
AGENT_PASSWORD=change-me
# Secret for signing session cookies (any long random string)
AUTH_SECRET=generate-a-long-random-string

# AI document reading (optional — demo simulation runs without it)
ANTHROPIC_API_KEY=

# Storage: leave unset for local demo store (.data/). Set all three for Supabase (create the
# project in ca-central-1 — Canadian data residency).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=client-docs

# Email nudges (optional — without it nudges are logged, not sent).
# SAFETY: in non-production, mail only ever goes to TEST_CONTACT_EMAIL regardless of recipient.
RESEND_API_KEY=
MAIL_FROM=documents@autowrite.ca
TEST_CONTACT_EMAIL=renee.ross@gmail.com
APP_ENV=test
